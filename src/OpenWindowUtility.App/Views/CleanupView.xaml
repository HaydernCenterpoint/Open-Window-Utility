<UserControl x:Class="OpenWindowUtility.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenWindowUtility.App.Markup">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button Content="{loc:Loc cleanup.selectSafe}" Command="{Binding SelectSafeCommand}" Margin="0,0,6,0" />
                <ui:Button Content="{loc:Loc cleanup.selectNone}" Command="{Binding SelectNoneCommand}" Margin="0,0,6,0" />
                <ui:Button Content="{loc:Loc cleanup.scan}" Command="{Binding ScanCommand}" Margin="0,0,6,0" />
                <ui:Button Appearance="Primary" Content="{loc:Loc cleanup.clean}" Command="{Binding CleanCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc nav.cleanup}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{loc:Loc cleanup.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,24,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FooterText}" Text="{Binding FooterText}" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource MetaLabel}" Text="{Binding StatusText}" />
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12"
                                    ToolTip="{Binding SamplesText}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <StackPanel DockPanel.Dock="Right" MinWidth="112" HorizontalAlignment="Right">
                                        <Border CornerRadius="4" Padding="6,1" HorizontalAlignment="Right" Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#24352C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Deep}" Value="True">
                                                            <Setter Property="Background" Value="#3A2A22" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Badge}" FontSize="10" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8FBF9A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Deep}" Value="True">
                                                                <Setter Property="Foreground" Value="#C4A574" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" />
                                        <TextBlock Style="{StaticResource MetaLabel}" HorizontalAlignment="Right"
                                                   Text="{Binding CountLabel}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MetaLabel}"
                                                   TextWrapping="Wrap" Margin="0,4,12,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
