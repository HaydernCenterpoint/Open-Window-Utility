<ui:FluentWindow x:Class="OpenWindowUtility.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:OpenWindowUtility.App.Markup"
        Title="Open Window Utility"
        Icon="pack://application:,,,/Assets/owu.png"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Style x:Key="LogToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="chev" Symbol="ChevronDown20" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{TemplateBinding Foreground}">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </ui:SymbolIcon.RenderTransform>
                                </ui:SymbolIcon>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chev" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{loc:Loc app.brand}"
                     Icon="pack://application:,,,/Assets/owu.png">
            <ui:TitleBar.TrailingContent>
                <Button Style="{StaticResource TitleUpdateButton}"
                        Command="{Binding AppUpdateCommand}"
                        ToolTip="{Binding UpdateTooltip}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{Binding UpdateLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource RailBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Tag="Settings"
                            Command="{Binding GoToCommand}" CommandParameter="Settings"
                            Style="{StaticResource NavButton}" Margin="10,0,10,14">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.settings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="18,8,18,18">
                            <Border Width="34" Height="34" CornerRadius="8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <Image Source="pack://application:,,,/Assets/owu.png" Stretch="Uniform"
                                       Margin="5" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc app.brand}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="UTILITY" FontSize="10" Margin="0,2,0,0"
                                           Foreground="{StaticResource FaintBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Tag="Applications" Command="{Binding GoToCommand}" CommandParameter="Applications"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.applications}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Tweaks" Command="{Binding GoToCommand}" CommandParameter="Tweaks"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.tweaks}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Config" Command="{Binding GoToCommand}" CommandParameter="Config"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.config}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Cleanup" Command="{Binding GoToCommand}" CommandParameter="Cleanup"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.cleanup}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Updates" Command="{Binding GoToCommand}" CommandParameter="Updates"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.updates}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Win11" Command="{Binding GoToCommand}" CommandParameter="Win11"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Disc24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.win11}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="24,6,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Content="{Binding CurrentPage}" />
                <StackPanel Grid.Row="1" Margin="0,10,0,0"
                            Visibility="{Binding HasLogLines, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="28"
                                VerticalAlignment="Center"
                                Content="{loc:Loc cancel}" Command="{Binding CancelJobCommand}" />
                        <ToggleButton Style="{StaticResource LogToggle}" IsChecked="{Binding IsLogExpanded}"
                                      Content="{loc:Loc log.title}" />
                    </DockPanel>
                    <Border Background="{StaticResource RailBrush}"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="8" Margin="0,6,0,0" Height="128"
                            Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}">
                        <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Foreground="{StaticResource MutedBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
