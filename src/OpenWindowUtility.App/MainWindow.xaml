<ui:FluentWindow x:Class="OpenWindowUtility.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:OpenWindowUtility.App.Markup"
        Title="Open Window Utility"
        Icon="pack://application:,,,/Assets/owu.png"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{loc:Loc app.brand}"
                     Icon="pack://application:,,,/Assets/owu.png">
            <ui:TitleBar.TrailingContent>
                <Button Style="{StaticResource TitleUpdateButton}"
                        Command="{Binding AppUpdateCommand}"
                        ToolTip="{Binding UpdateTooltip}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{Binding UpdateLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource RailBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Tag="Settings"
                            Command="{Binding GoToCommand}" CommandParameter="Settings"
                            Style="{StaticResource NavButton}" Margin="10,0,10,16">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.settings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <StackPanel Margin="0,8,0,0">
                        <Button Tag="Applications" Command="{Binding GoToCommand}" CommandParameter="Applications"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.applications}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Tweaks" Command="{Binding GoToCommand}" CommandParameter="Tweaks"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.tweaks}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Config" Command="{Binding GoToCommand}" CommandParameter="Config"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.config}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Cleanup" Command="{Binding GoToCommand}" CommandParameter="Cleanup"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.cleanup}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Updates" Command="{Binding GoToCommand}" CommandParameter="Updates"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc nav.updates}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="24,4,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Content="{Binding CurrentPage}" />
                <Expander Grid.Row="1" Header="{loc:Loc log.title}"
                          IsExpanded="{Binding IsLogExpanded}" Margin="0,12,0,0">
                    <DockPanel Height="112">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"
                                Content="{loc:Loc cancel}" Command="{Binding CancelJobCommand}" />
                        <ListBox ItemsSource="{Binding LogLines}" Background="#0E1014" BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </DockPanel>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
