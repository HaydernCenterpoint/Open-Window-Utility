<UserControl x:Class="OpenWindowUtility.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenWindowUtility.App.Markup">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="{loc:Loc updates.title}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc updates.status}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ProductName}" />
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{Binding DisplayVersion}" />
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{Binding Build, StringFormat=Build {0}}" />
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{Binding UpdateConfiguration}" />
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{Binding InstallDate}" />
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{Binding BootTime}" />
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{Binding LastUpdate}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc updates.catalogs}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AppsVersion, StringFormat=Applications JSON  {0}}" />
                        <TextBlock Text="{Binding TweaksVersion, StringFormat=Tweaks JSON  {0}}" />
                        <TextBlock Text="{Binding FeaturesVersion, StringFormat=Features JSON  {0}}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc updates.app}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <ui:Button Appearance="Primary" Margin="0,0,8,0" Height="40" Content="{loc:Loc updates.default}" Command="{Binding ApplyDefaultCommand}" />
                <ui:Button Margin="4,0,4,0" Height="40" Content="{loc:Loc updates.security}" Command="{Binding ApplySecurityCommand}" />
                <ui:Button Height="40" Appearance="Danger" Content="{loc:Loc updates.disable}" Command="{Binding ApplyDisableCommand}" />
            </UniformGrid>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc updates.what}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Style="{StaticResource PageSubtitle}" Text="{loc:Loc updates.default.body}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Style="{StaticResource PageSubtitle}" Text="{loc:Loc updates.security.body}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Text="{loc:Loc updates.disable.body}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
