<Application x:Class="OpenWindowUtility.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:OpenWindowUtility.App.ViewModels"
             xmlns:views="clr-namespace:OpenWindowUtility.App.Views"
             xmlns:conv="clr-namespace:OpenWindowUtility.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:NavSelectedConverter x:Key="NavSelected" />

            <!-- Palette: quiet workshop tool. One accent, two tones (fill for controls, text tone for labels/lines). -->
            <Color x:Key="CanvasColor">#101318</Color>
            <Color x:Key="RailColor">#0B0D11</Color>
            <Color x:Key="SurfaceColor">#171B21</Color>
            <Color x:Key="SurfaceHoverColor">#1E242C</Color>
            <Color x:Key="HairlineColor">#272C35</Color>
            <Color x:Key="TextColor">#E9EBEE</Color>
            <Color x:Key="MutedColor">#9AA1AC</Color>
            <Color x:Key="FaintColor">#6C7480</Color>
            <Color x:Key="AccentColor">#5FAE9B</Color>
            <Color x:Key="AccentFillColor">#2E6A5E</Color>
            <Color x:Key="AccentTintColor">#182B26</Color>
            <Color x:Key="OkColor">#8FCBA4</Color>
            <Color x:Key="OkTintColor">#1F2E26</Color>
            <Color x:Key="WarnColor">#D3A969</Color>
            <Color x:Key="WarnTintColor">#32291C</Color>
            <Color x:Key="DangerColor">#E06B5F</Color>
            <Color x:Key="DangerFillColor">#A93B38</Color>
            <Color x:Key="DangerTintColor">#33201F</Color>
            <Color x:Key="InfoColor">#8FA8C6</Color>
            <Color x:Key="InfoTintColor">#1F2833</Color>
            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
            <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentFillColor}" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
            <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
            <SolidColorBrush x:Key="OkTintBrush" Color="{StaticResource OkTintColor}" />
            <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
            <SolidColorBrush x:Key="WarnTintBrush" Color="{StaticResource WarnTintColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="DangerFillBrush" Color="{StaticResource DangerFillColor}" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
            <SolidColorBrush x:Key="InfoTintBrush" Color="{StaticResource InfoTintColor}" />

            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <Style TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="PanningMode" Value="VerticalOnly" />
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            </Style>
            <Style x:Key="MetaLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            </Style>
            <Style x:Key="FooterText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>

            <Style x:Key="MeterBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="6" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Background" Value="#232833" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                        Background="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="AppTile" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Width" Value="136" />
                <Setter Property="Height" Value="136" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            </Style>

            <!-- Compact borderless action for tertiary commands. -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Destructive action: tinted at rest, solid danger fill on hover. -->
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
                <Setter Property="BorderBrush" Value="#4B2A28" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerFillBrush}" />
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DangerFillBrush}" />
                                    <Setter Property="Foreground" Value="#F5F6F8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ConfigPanelButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="148" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TitleUpdateButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="8,0,10,0" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Rail navigation: label + icon, hairline-quiet at rest, accent side bar when active. -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Margin" Value="10,0,10,3" />
                <Setter Property="Padding" Value="11,0,12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bar"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="3,0,0,0"
                                    CornerRadius="6"
                                    Background="Transparent">
                                <Border x:Name="bd" Margin="3,0,0,0"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource NavSelected}">
                                <Binding Path="Section" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
                <views:ApplicationsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
                <views:TweaksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
                <views:ConfigView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
                <views:CleanupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
                <views:UpdatesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:Win11CreatorViewModel}">
                <views:Win11CreatorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <DataTemplate x:Key="TweakCheckTemplate">
                <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <CheckBox IsChecked="{Binding IsSelected}" VerticalContentAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="FeatureCheckTemplate">
                <Border CornerRadius="6" Padding="8,6" Margin="0,0,6,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <CheckBox IsChecked="{Binding IsSelected}" VerticalContentAlignment="Top"
                              IsEnabled="{Binding IsEditionSupported}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
