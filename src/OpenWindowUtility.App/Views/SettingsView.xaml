<UserControl x:Class="OpenWindowUtility.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenWindowUtility.App.Markup">
    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock Text="{loc:Loc nav.settings}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
        <ComboBox Width="280" HorizontalAlignment="Left" SelectedValue="{Binding LanguageChoice}" SelectedValuePath="Tag">
            <ComboBoxItem Tag="auto" Content="{loc:Loc settings.language.auto}" />
            <ComboBoxItem Tag="en" Content="{loc:Loc settings.language.en}" />
            <ComboBoxItem Tag="vi" Content="{loc:Loc settings.language.vi}" />
        </ComboBox>
        <CheckBox Margin="0,20,0,0" IsChecked="{Binding CreateRestorePoint}" Content="{loc:Loc settings.restore}" />
        <TextBlock Text="{loc:Loc settings.updateFeed}" Style="{StaticResource SectionLabel}" Margin="0,24,0,8" />
        <TextBox Width="480" HorizontalAlignment="Left"
                 Text="{Binding UpdateFeedUrl, UpdateSourceTrigger=LostFocus}" />
        <TextBlock Margin="0,8,0,0" Style="{StaticResource MetaLabel}" TextWrapping="Wrap"
                   Text="{loc:Loc settings.updateFeed.hint}" />
        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <ui:Button Content="{loc:Loc settings.export}" Command="{Binding ExportProfileCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{loc:Loc settings.import}" Command="{Binding ImportProfileCommand}" />
        </StackPanel>
        <TextBlock Margin="0,32,0,0" Style="{StaticResource PageSubtitle}" Text="{loc:Loc settings.attribution}" />
    </StackPanel>
</UserControl>
