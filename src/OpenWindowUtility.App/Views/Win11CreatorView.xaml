<UserControl x:Class="OpenWindowUtility.App.Views.Win11CreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenWindowUtility.App.Markup">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button Content="{loc:Loc apps.selectAll}" Command="{Binding SelectAllBypassesCommand}" Margin="0,0,6,0" />
                <Button Style="{StaticResource GhostButton}" Content="{loc:Loc apps.deselectAll}"
                        Command="{Binding DeselectAllBypassesCommand}" Margin="0,0,6,0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc win11.title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{loc:Loc win11.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,24,0" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Hardware & Requirements -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,16,12,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="{loc:Loc win11.group.hardware}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{loc:Loc win11.group.hardware.desc}" Style="{StaticResource MetaLabel}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,10,0,6" />
                    </StackPanel>
                    <ScrollViewer>
                        <StackPanel Margin="0,0,4,0">
                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding BypassTpm}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.tpm}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.tpm.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding BypassSecureBoot}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.secureboot}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.secureboot.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding BypassRam}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.ram}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.ram.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding BypassCpu}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.cpu}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.cpu.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding BypassStorage}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.storage}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.storage.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding BypassDiskCheck}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.diskcheck}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.diskcheck.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding DisableBitLocker}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.bitlocker}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.bitlocker.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 2: Account & OOBE Setup -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,16,12,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="{loc:Loc win11.group.account}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{loc:Loc win11.group.account.desc}" Style="{StaticResource MetaLabel}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,10,0,6" />
                    </StackPanel>
                    <ScrollViewer>
                        <StackPanel Margin="0,0,4,0">
                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding BypassMicrosoftAccount}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.msaccount}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.msaccount.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding DisableOobeTelemetry}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.telemetry}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.telemetry.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding DisableConsumerExperience}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.consumer}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.consumer.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding SkipEula}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.skipeula}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.skipeula.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding EnableFirstLogonTweaks}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc win11.firstlogon}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{loc:Loc win11.firstlogon.desc}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,10,0,10" />

                            <TextBlock Text="{loc:Loc win11.user.name}" Style="{StaticResource SectionLabel}" FontSize="12" Margin="4,0,0,4" />
                            <TextBox Text="{Binding LocalUsername, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,4,8" />

                            <TextBlock Text="{loc:Loc win11.user.pass}" Style="{StaticResource SectionLabel}" FontSize="12" Margin="4,0,0,4" />
                            <TextBox Text="{Binding LocalPassword, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,4,8" />

                            <CheckBox IsChecked="{Binding AutoLogon}" Content="{loc:Loc win11.user.autologon}" Margin="4,0,0,8" />

                            <TextBlock Text="{loc:Loc win11.computername}" Style="{StaticResource SectionLabel}" FontSize="12" Margin="4,0,0,4" />
                            <TextBox Text="{Binding ComputerName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,4,4" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 3: Export & Build Options -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,16,16,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Output &amp; Build" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Choose whether to export autounattend.xml or package a full ISO." Style="{StaticResource MetaLabel}"
                                   TextWrapping="Wrap" Margin="0,6,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Content="{loc:Loc win11.export.xml}" IsChecked="{Binding IsXmlMode, Mode=TwoWay}"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="{loc:Loc win11.export.iso}" IsChecked="{Binding IsIsoMode, Mode=TwoWay}" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,14" />
                    </StackPanel>

                    <!-- XML Mode View -->
                    <StackPanel Visibility="{Binding IsXmlMode, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="autounattend.xml" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="13" />
                                <TextBlock Text="Generates an answer file with your customized bypasses and offline account. Place this file directly at the root of your installation USB drive (e.g. E:\autounattend.xml)."
                                           Style="{StaticResource MetaLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <ui:Button Appearance="Primary" Height="36" HorizontalAlignment="Stretch"
                                   Content="{loc:Loc win11.action.exportXml}" Command="{Binding ExportXmlCommand}" />
                    </StackPanel>

                    <!-- ISO Mode View -->
                    <StackPanel Visibility="{Binding IsIsoMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc win11.select.source}" Style="{StaticResource SectionLabel}" FontSize="12" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourceIsoPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="{loc:Loc win11.browse}" Style="{StaticResource GhostButton}"
                                    Command="{Binding BrowseSourceIsoCommand}" Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Text="{loc:Loc win11.select.output}" Style="{StaticResource SectionLabel}" FontSize="12" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputIsoPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="{loc:Loc win11.browse}" Style="{StaticResource GhostButton}"
                                    Command="{Binding BrowseOutputIsoCommand}" Margin="6,0,0,0" />
                        </Grid>

                        <ui:Button Appearance="Primary" Height="36" HorizontalAlignment="Stretch"
                                   Content="{loc:Loc win11.action.buildIso}" Command="{Binding BuildIsoCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
