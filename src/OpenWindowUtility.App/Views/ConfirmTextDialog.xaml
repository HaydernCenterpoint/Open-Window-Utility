<Window x:Class="OpenWindowUtility.App.Views.ConfirmTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1D24"
        Foreground="#E8EAED"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="14" />
        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,16,0,16" Padding="8" Background="#0E1014" Foreground="#E8EAED" BorderBrush="#4A7D76" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Width="110" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="OkButton" Width="140" Click="Ok_Click" Background="#EF4444" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
