<UserControl x:Class="OpenWindowUtility.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenWindowUtility.App.Markup">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}"
                   Text="{loc:Loc nav.applications}" Margin="0,0,0,16" />
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FooterText}" Text="{Binding FooterText}" />
        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <ui:TextBox MinWidth="220" Width="280" Margin="0,0,8,8"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{loc:Loc apps.search}" />
                <ComboBox Width="180" Margin="0,0,8,8"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="all">
                                                <Setter Property="Text" Value="{loc:Loc apps.category.all}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Width="220" Margin="0,0,8,8" SelectedValue="{Binding SelectedManager}" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="auto" Content="{loc:Loc apps.manager.auto}" />
                    <ComboBoxItem Tag="winget" Content="{loc:Loc apps.manager.winget}" />
                    <ComboBoxItem Tag="chocolatey" Content="{loc:Loc apps.manager.choco}" />
                </ComboBox>
                <ui:Button Appearance="Primary" Content="{loc:Loc apps.install}"
                           Command="{Binding InstallCommand}" Margin="0,0,6,8" />
                <ui:Button Content="{loc:Loc apps.uninstall}" Command="{Binding UninstallCommand}" Margin="0,0,6,8" />
                <ui:Button Content="{loc:Loc apps.upgradeAll}" Command="{Binding UpgradeAllCommand}" Margin="0,0,6,8" />
                <ui:Button Content="{loc:Loc apps.selectAll}" Command="{Binding SelectAllCommand}" Margin="0,0,6,8" />
                <ui:Button Content="{loc:Loc apps.deselectAll}" Command="{Binding DeselectAllCommand}" Margin="0,0,6,8" />
                <ui:Button Content="{loc:Loc apps.refresh}" Command="{Binding RefreshInstalledCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <DockPanel>
                <Border DockPanel.Dock="Right" Width="280" Margin="12,0,0,0"
                        Style="{StaticResource Card}"
                        Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Right"
                                Content="{loc:Loc apps.detail.close}"
                                Command="{Binding CloseDetailCommand}" />
                        <ui:Button DockPanel.Dock="Bottom" Appearance="Primary" HorizontalAlignment="Stretch"
                                   Content="{loc:Loc apps.detail.download}"
                                   Command="{Binding DownloadDetailCommand}"
                                   Margin="0,16,0,0" />
                        <ScrollViewer Margin="0,12,0,0">
                            <StackPanel>
                                <Image Width="56" Height="56" HorizontalAlignment="Left"
                                       Source="{Binding DetailItem.IconUrl, NotifyOnTargetUpdated=True}"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       TargetUpdated="AppIcon_TargetUpdated"
                                       ImageFailed="AppIcon_ImageFailed" />
                                <TextBlock Text="{Binding DetailItem.Name}" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,12,0,14" />
                                <TextBlock Style="{StaticResource MetaLabel}" Text="{loc:Loc apps.detail.publisher}" />
                                <TextBlock Text="{Binding DetailPublisher}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource MetaLabel}" Text="{loc:Loc apps.detail.version}" />
                                <TextBlock Text="{Binding DetailVersion}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource MetaLabel}" Text="{loc:Loc apps.detail.updated}" />
                                <TextBlock Text="{Binding DetailUpdated}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource MetaLabel}" Text="{loc:Loc apps.detail.description}" />
                                <TextBlock Text="{Binding DetailItem.Description}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding VisibleItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AppTile}"
                                        ToolTip="{Binding Description}"
                                        MouseLeftButtonUp="AppCard_MouseLeftButtonUp">
                                    <Grid>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image Width="44" Height="44" Margin="0,0,0,8"
                                                   Source="{Binding IconUrl, NotifyOnTargetUpdated=True}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   TargetUpdated="AppIcon_TargetUpdated"
                                                   ImageFailed="AppIcon_ImageFailed" />
                                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                                                       MaxHeight="36" FontSize="12" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                <Border Background="#24352C" CornerRadius="4" Padding="6,1" Margin="0,0,4,0"
                                                        Visibility="{Binding Foss, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="FOSS" FontSize="10" Foreground="#8FBF9A" />
                                                </Border>
                                                <Border Background="#243040" CornerRadius="4" Padding="6,1"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ON" FontSize="10" Foreground="#8FA4BF" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </DockPanel>
</UserControl>
