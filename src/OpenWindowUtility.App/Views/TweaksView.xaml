<UserControl x:Class="OpenWindowUtility.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenWindowUtility.App.Markup">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button Appearance="Primary" Content="{loc:Loc tweaks.apply}" Command="{Binding ApplyCommand}" Margin="0,0,6,0" />
                <ui:Button Content="{loc:Loc tweaks.essential}" Command="{Binding SelectEssentialCommand}" Margin="0,0,6,0" />
                <ui:Button Content="{loc:Loc tweaks.undo}" Command="{Binding UndoCommand}" Margin="0,0,6,0" />
                <Button Style="{StaticResource GhostButton}" Content="{loc:Loc tweaks.deselect}"
                        Command="{Binding DeselectAllCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding LoadedText}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FooterText}" Text="{Binding FooterText}" />
        <ScrollViewer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Loc tweaks.essentialHeading}" Style="{StaticResource SectionLabel}" />
                            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,10,0,6" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Essential}" ItemTemplate="{StaticResource TweakCheckTemplate}" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Loc tweaks.advancedHeading}" Style="{StaticResource SectionLabel}"
                                       Foreground="{StaticResource WarnBrush}" />
                            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,10,0,6" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Advanced}" ItemTemplate="{StaticResource TweakCheckTemplate}" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Loc tweaks.togglesHeading}" Style="{StaticResource SectionLabel}" />
                            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,10,0,6" />
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Toggles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel LastChildFill="True">
                                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsSelected}"
                                                                 Command="{Binding DataContext.TogglePreferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 CommandParameter="{Binding}" />
                                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MetaLabel}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
